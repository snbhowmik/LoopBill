  "narrative": {
    "northStar": "The Quiet Instrument",
    "overview": "LoopBill is a tool that recedes so the work can come forward. Most of the screen is warm paper and ink: off-white canvas, white working surfaces, near-black text and hairline rules. The interface is dense and legible because its users process hundreds of records at a time. Brand shows up in precise details rather than decoration: one green ink, perfectly aligned figures, and statuses that always tell you where a record stands.\n\nDepth is tonal, not lifted. Sections sit on the canvas as flat, ruled cards. Tables are the main form. Numbers use tabular figures so columns of rupees line up to the paisa. Color is rationed: Ledger Green marks the primary action, the current place and money received. Red, amber and blue are reserved for state and never decorate.\n\nBack office and customer portal share the same system. The portal uses a narrower column and top tabs instead of a sidebar, but the same cards, tables, badges and document styles.",
    "keyCharacteristics": [
      "Warm paper neutrals with a single green ink accent.",
      "Flat, hairline-ruled surfaces; no shadows at rest.",
      "Tables first, with tabular figures for every number.",
      "Status shown by pill badges that pair color with a dot and a word, never color alone.",
      "Dense but calm: 14px body, generous row height, quiet column headers.",
      "Full light and dark themes driven by the same tokens."
    ],
    "rules": [
      {
        "name": "The One Ink Rule",
        "body": "Ledger Green is the only brand hue. Any new accent must be one of the status hues, used for state.",
        "section": "colors"
      },
      {
        "name": "The State-Only Rule",
        "body": "Red, amber and blue appear only to mean a state (overdue, pending, quotation, error). They are never decoration.",
        "section": "colors"
      },
      {
        "name": "The Data Ink Rule",
        "body": "Chart marks use Chart Green, never Ledger Green, and chart text stays in the ink tokens.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that can sit in a column (amounts, quantities, dates, document numbers) uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The One Face Rule",
        "body": "Geist only. Add emphasis with weight; never add a display face.",
        "section": "typography"
      },
      {
        "name": "The Volume Rule",
        "body": "Lists paginate at 25 rows, filter in the URL, and keep filters in one row directly above the table they control.",
        "section": "layout"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces are flat at rest. A shadow means the element floats above the page; anything sitting in the page uses a border instead.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep Ledger Green (#1f6f5c) for the single primary action, the current location and money received.",
      "Do use tabular figures and right alignment for every amount, quantity and date column.",
      "Do pair every status color with a dot and a word in a pill badge.",
      "Do separate surfaces with 1px Hairline Rules (#e4e1d8) instead of shadows.",
      "Do keep text in ink tokens even next to a colored mark.",
      "Do keep both themes valid: every new color needs a light and a dark value in `globals.css`."
    ],
    "donts": [
      "Don't introduce a second brand hue or decorative gradients.",
      "Don't use red, amber or blue for anything except state.",
      "Don't add shadows to cards, tables or anything else that sits in the page.",
      "Don't add a second typeface.",
      "Don't show status with color alone."
    ]
  }
}