generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         Role      @default(CUSTOMER)
  active       Boolean   @default(true)
  customerId   String?   @unique
  customer     Customer? @relation(fields: [customerId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions    Session[]
  resetTokens PasswordResetToken[]
  activities  Activity[]
  payments    Payment[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Every outgoing email is recorded; without SMTP configured this doubles as a
// local dev mailbox.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String?
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  entity    String // "subscription" | "invoice" | ...
  entityId  String
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  address   String?
  taxId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Tax {
  id        String   @id @default(cuid())
  name      String
  rate      Decimal  @db.Decimal(6, 2) // percent, e.g. 18.00
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]
  plans    RecurringPlan[]
  lines    SubscriptionLine[]
}

enum ProductType {
  SERVICE
  GOODS
}

model Product {
  id         String      @id @default(cuid())
  name       String
  type       ProductType @default(SERVICE)
  salesPrice Decimal     @db.Decimal(12, 2)
  costPrice  Decimal     @default(0) @db.Decimal(12, 2)
  notes      String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  taxes         Tax[]
  variants      ProductVariant[]
  discounts     Discount[]
  lines         SubscriptionLine[]
  templateLines QuotationTemplateLine[]
  invoiceLines  InvoiceLine[]

  @@index([name])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String // e.g. "Brand"
  value      String // e.g. "Northwind"
  extraPrice Decimal @default(0) @db.Decimal(12, 2)

  lines         SubscriptionLine[]
  templateLines QuotationTemplateLine[]

  @@unique([productId, attribute, value])
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringPlan {
  id             String        @id @default(cuid())
  name           String
  price          Decimal       @db.Decimal(12, 2) // per unit, per billing period
  billingPeriod  BillingPeriod @default(MONTHLY)
  minQuantity    Int           @default(1)
  availableFrom  DateTime?     @db.Date
  availableUntil DateTime?     @db.Date
  autoClose      Boolean       @default(false) // close subscriptions automatically at expiry
  closable       Boolean       @default(true) // may be closed before expiry
  pausable       Boolean       @default(false)
  renewable      Boolean       @default(true)
  active         Boolean       @default(true)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  taxes         Tax[]
  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

model PaymentTerm {
  id      String @id @default(cuid())
  name    String
  dueDays Int    @default(0)

  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

model QuotationTemplate {
  id            String       @id @default(cuid())
  name          String
  validityDays  Int          @default(30)
  planId        String
  plan          RecurringPlan @relation(fields: [planId], references: [id])
  quantity      Int          @default(1)
  durationCount Int? // contract length in billing periods; empty = open-ended
  paymentTermId String?
  paymentTerm   PaymentTerm? @relation(fields: [paymentTermId], references: [id])
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lines         QuotationTemplateLine[]
  subscriptions Subscription[]
}

model QuotationTemplateLine {
  id         String            @id @default(cuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int               @default(1)
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCTS
  SUBSCRIPTION
}

model Discount {
  id          String        @id @default(cuid())
  name        String
  type        DiscountType
  value       Decimal       @db.Decimal(12, 2)
  scope       DiscountScope @default(SUBSCRIPTION)
  minPurchase Decimal?      @db.Decimal(12, 2)
  minQuantity Int?
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  usageLimit  Int?
  usedCount   Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products      Product[]
  subscriptions Subscription[]
  usages        InvoiceDiscount[]
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

model Subscription {
  id                  String             @id @default(cuid())
  number              String             @unique
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id])
  planId              String
  plan                RecurringPlan      @relation(fields: [planId], references: [id])
  templateId          String?
  template            QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  paymentTermId       String
  paymentTerm         PaymentTerm        @relation(fields: [paymentTermId], references: [id])
  status              SubscriptionStatus @default(DRAFT)
  quantity            Int                @default(1)
  startDate           DateTime           @db.Date
  expiryDate          DateTime?          @db.Date
  quotationValidUntil DateTime?          @db.Date
  // Billing cursor: period N starts at startDate + N billing periods.
  invoicedCycles      Int                @default(0)
  nextInvoiceDate     DateTime?          @db.Date
  notes               String?
  confirmedAt         DateTime?
  activatedAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  lines     SubscriptionLine[]
  discounts Discount[]
  invoices  Invoice[]

  @@index([status, nextInvoiceDate])
  @@index([customerId])
  @@index([planId])
  @@index([createdAt])
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxes          Tax[]

  @@index([subscriptionId])
}

// ---------------------------------------------------------------------------
// Invoicing & payments
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date // exclusive
  invoiceDate    DateTime      @db.Date
  dueDate        DateTime      @db.Date
  untaxedAmount  Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  sentAt         DateTime?
  confirmedAt    DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines     InvoiceLine[]
  payments  Payment[]
  discounts InvoiceDiscount[]

  // A partial unique index on (subscriptionId, periodStart) for non-cancelled
  // invoices is created in SQL migration "billing_guards".
  @@index([status, dueDate])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([invoiceDate])
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(6, 2)
  taxLabel       String?
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  sortOrder      Int      @default(0)

  @@index([invoiceId])
}

model InvoiceDiscount {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)

  @@unique([invoiceId, discountId])
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  UPI
  CHEQUE
  OTHER
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paidOn       DateTime      @db.Date
  note         String?
  recordedById String?
  recordedBy   User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidOn])
}
